{
  "name": "financial-platform",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build:shared": "npm run build -w @fp/shared",
    "test:contracts": "npm run test -w @fp/contracts",
    "test:api": "npm run build -w @fp/shared && npm run test -w @fp/api",
    "test": "npm run test:contracts && npm run test:api",
    "db:start": "node scripts/postgres.mjs",
    "dev:api": "npm run dev -w @fp/api",
    "dev:web": "npm run dev -w @fp/web",
    "prisma:generate": "npm run prisma:generate -w @fp/api",
    "prisma:deploy": "npm run prisma:deploy -w @fp/api"
  },
  "dependencies": {
    "embedded-postgres": "18.6.0-beta.19"
  }
}
